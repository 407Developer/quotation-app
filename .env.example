# AI Provider ("openai" | "groq")
AI_PROVIDER=groq

# AI API Key (supports OpenAI, Groq, or any OpenAI-compatible API)
AI_API_KEY=

# Optional: override model (defaults: gpt-4o-mini for openai, llama3-70b-8192 for groq)
# AI_MODEL=llama3-70b-8192

# Optional: custom base URL for OpenAI-compatible APIs
# AI_BASE_URL=

# Path to Chrome/Chromium executable for PDF generation (puppeteer-core)
# Default: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=

# When no API key is set, the app falls back to a mock parser
# for development/testing purposes.
